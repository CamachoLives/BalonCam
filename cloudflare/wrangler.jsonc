{
  // BalonCam en Cloudflare Workers (plan gratis).
  // Desplegar desde el PC:  cd cloudflare && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baloncam",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist/baloncam/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baloncam-db",
      "database_id": "REEMPLAZAR_CON_EL_ID_DE_D1"
    }
  ]
  // El PIN del panel /admin es un secreto:  npx wrangler secret put ADMIN_PIN
}
